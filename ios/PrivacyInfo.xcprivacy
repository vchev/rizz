<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Apple privacy manifest, copied into the app and each extension.
     Must match the App Store "Data Not Collected" label and hicoax.com/privacy/.
     Re-check before adding analytics, crash reporting, an account or any SDK. -->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: settings read and written only by this app. -->
				<string>CA92.1</string>
				<!-- 1C8F.1: the shared App Group settings between the app and its extensions. -->
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
